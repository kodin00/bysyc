# bysyc — copy to .env and set the change-me secrets before docker compose up.
# Non-secret tunables ship working defaults; only flip them to taste.

# --- secrets (set these) ---

# Password for the bysyc Postgres user (compose generates nothing — set this)
POSTGRES_PASSWORD=change-me

# Shared secret for the TURN relay user
TURN_PASSWORD=change-me

# SeaweedFS S3 credentials the bysyc server uses to store/retrieve encrypted
# blobs. These MUST match the accessKey/secretKey in deploy/seaweedfs/s3.json
# (see deploy/README.md); the S3 gateway rejects SigV4 requests otherwise.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- coturn / TURN ---

# Public IP coturn advertises for relayed candidates. Local dev: 127.0.0.1.
# On a VPS set this to the host's public IP (or a hostname resolving to it).
COTURN_EXTERNAL_IP=127.0.0.1

# TURN public address clients dial (coturn realm is "bysyc")
TURN_ADDR=localhost:3478
# TURN long-term-credential username (must match the --user in docker-compose)
TURN_USER=bysyc

# --- SeaweedFS S3 ---

# S3 gateway endpoint. Inside compose the server reaches seaweedfs:8333;
# host-side dev (mise run dev-server) uses the published loopback port.
S3_ENDPOINT=http://127.0.0.1:8333
# Bucket the server targets for attachment blobs (created on first use)
S3_BUCKET=bysyc

# --- Postgres / Redis ---

# Host-side dev (mise run dev-server) — compose publishes loopback ports:
DATABASE_URL=postgres://bysyc:<POSTGRES_PASSWORD>@127.0.0.1:15432/bysyc
REDIS_URL=redis://127.0.0.1:16379/1
# Postgres pool ceiling (sqlx). 16 is ample for a single small instance.
DB_MAX_CONNECTIONS=16

# --- server tunables ---

# Address the server binds. Loopback for dev; in compose the image listens on
# 0.0.0.0:8080 (default) and the port mapping is loopback-bound.
BIND_ADDR=127.0.0.1:8080
# Ciphertext-size cap per attachment, in megabytes.
ATTACHMENT_MAX_MB=50
# Per-IP auth rate limit: hits/min/IP on register + login (sliding 60s window).
AUTH_RATE_PER_MIN=5
# Gateway Redis pub/sub subscribers homing WebSocket event topics (clamped 1..=8).
WS_EVENT_WORKERS=4
# Number of trusted reverse-proxy hops in front of the server, e.g. 1 behind
# Caddy; 0 means ignore X-Forwarded-For and key the rate-limiter on the direct
# peer IP. Without this gate any client could forge the header to reset its key.
TRUSTED_PROXY_HOPS=0
